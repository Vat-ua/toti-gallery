{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev:auth-test": "node scripts/run-auth-test.cjs dev",
    "build:auth-test": "node scripts/run-auth-test.cjs build",
    "start:auth-test": "node scripts/run-auth-test.cjs start",
    "account:admin": "tsx scripts/account-admin.ts",
    "test:auth": "node --import tsx --test tests/auth.test.ts",
    "test:database-target": "node --import tsx --test tests/database-target.test.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@better-auth/drizzle-adapter": "1.7.13",
    "@playwright/test": "^1.64.1",
    "better-auth": "1.7.13",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.3",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}

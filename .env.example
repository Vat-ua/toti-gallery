# Replace these placeholder credentials with your development database settings.
DATABASE_URL=postgresql://YOUR_DEV_ROLE:YOUR_DEV_PASSWORD@YOUR_DEV_ENDPOINT.neon.tech/toti_gallery?sslmode=require
GALLERY_DATABASE_ENV=development
DATABASE_NAME=toti_gallery
NEON_PROJECT_ID=morning-bread-11732042
NEON_BRANCH_ID=YOUR_DEVELOPMENT_BRANCH_ID
NEON_ENDPOINT_ID=YOUR_DEVELOPMENT_ENDPOINT_ID

# Generate a unique secret: openssl rand -base64 48
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Set the exact stable origin; do not use a wildcard or an untrusted Host header.
BETTER_AUTH_URL=http://localhost:3000

# Optional together. Email/password works when both are absent.
# GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID
# GOOGLE_CLIENT_SECRET=YOUR_WEB_OAUTH_CLIENT_SECRET
